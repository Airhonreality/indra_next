{
  "$schema": "https://schema.tauri.app/config/v2",
  "productName": "Indra Installer",
  "version": "0.1.0",
  "identifier": "com.indra.installer",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "frontendDist": "../src-tauri/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Indra Desktop Storage",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "updater": {
    "active": true,
    "endpoints": [
      "https://api.indra.app/api/daemon/update/{{target}}/{{arch}}"
    ],
    "dialog": true,
    "pubkey": "dW5kZXJzdGFuZCBXaW5kb3dzIHNpZ25pbmdQT1M="
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "msiTemplate": null,
    "createUpdaterArtifacts": true,
    "windows": [
      {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "signingIdentity": null,
        "timestampUrl": ""
      }
    ],
    "nsis": {
      "template": null,
      "licensePath": null,
      "headerImage": null,
      "sidebarImage": null,
      "installerIcon": null,
      "uninstallerIcon": null,
      "uninstallDisplayName": "Indra Installer",
      "customInstallActions": [],
      "customUninstallActions": [],
      "allowToChangeInstallDirectory": true,
      "displayLanguageSelector": false,
      "oneClick": false
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "epoch": 0
      }
    },
    "macOS": {
      "licenseFile": null,
      "signing": {
        "certificateFile": null,
        "certificatePassword": null,
        "signingIdentity": null,
        "entitlements": null
      }
    }
  }
}
